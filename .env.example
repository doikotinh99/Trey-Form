# ==============================================================================
# SMTP & Mail Configuration Environment Variables (Example Template)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=your_gmail_or_smtp_user@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_TIMEOUT=15

# Default Recipient Email
MAIL_DEFAULT_TO=treydurden@gmail.com

# Sender Information
FROM_EMAIL=service@hvaccomfort.com
FROM_NAME=HVAC Comfort Services

# Dev Mode
DEV_MODE=true
